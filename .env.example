# Example environment for `compose.yaml`. This file holds no real secret.
#
# Run `scripts/dev-env.sh` to create `.env` with random values, or copy this file to `.env` and
# generate each value with the command below. The Compose file reads `.env` from the repository
# root.

# The PostgreSQL superuser of the development cluster.
POSTGRES_USER=restichub
# Generate a value with: head -c 32 /dev/urandom | base64
POSTGRES_PASSWORD=
POSTGRES_DB=restichub

# The passwords of the two installation logins. `db-bootstrap` sets them with `ALTER ROLE`.
# Generate each value with: head -c 32 /dev/urandom | base64
RESTICHUB_OWNER_PASSWORD=
RESTICHUB_RUNTIME_PASSWORD=

# The key encryption key (KEK). It must hold 32 bytes in standard base64, or the control plane
# refuses to start. Generate one with:
#
#   head -c 32 /dev/urandom | base64
#
# Or run `scripts/dev-env.sh` to write `.env` with random values.
RESTICHUB_KEK=

# The tenancy mode: `single` or `multi`. The default is `single`, which shows no tenant in the UI
# and in the API. See design/adr/0024-single-tenant-mode.md.
RESTICHUB_TENANCY_MODE=single
