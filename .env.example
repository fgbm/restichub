# Example environment for `compose.yaml`. This file holds no real secret.
#
# Run `scripts/dev-env.sh` to create `.env` with random values, or copy this file to `.env` and
# replace every `change-me`. The Compose file reads `.env` from the repository root.

# The PostgreSQL superuser of the development cluster.
POSTGRES_USER=restichub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=restichub

# The passwords of the two installation logins. `db-bootstrap` sets them with `ALTER ROLE`.
RESTICHUB_OWNER_PASSWORD=change-me
RESTICHUB_RUNTIME_PASSWORD=change-me

# The key encryption key. The control plane reads it with the secrets configuration (issue #20).
RESTICHUB_KEK=change-me
