stateDiagram-v2
  direction TB
  state "{{jobs.status.queued}} · queued" as queued
  state "{{jobs.status.sent}} · sent" as sent
  state "{{jobs.status.running}} · running" as running
  state "{{jobs.status.succeeded}} · succeeded" as succeeded
  state "{{jobs.status.failed}} · failed" as failed
  state "{{jobs.status.expired}} · expired" as expired
  state "{{jobs.status.dead_letter}} · dead_letter" as dead_letter

  [*] --> queued: schedule, {{plans.run}}, maintenance
  queued --> expired: acceptance window ended
  queued --> failed: refused, cancelled
  queued --> sent: signed and sent
  sent --> failed: not confirmed, cancelled
  sent --> running: agent confirms
  running --> failed: step failed, stalled, host lost
  running --> succeeded: steps ended
  running --> dead_letter: locked after the last retry
