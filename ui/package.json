{
	"name": "restichub-ui",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"gen:api": "openapi-typescript ${OPENAPI_URL:-http://127.0.0.1:8080/api/v1/openapi.json} -o src/lib/api/schema.d.ts"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.6.5",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.2",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
