# Example environment for the reference stack. This file holds no real secret.
#
# Run `./init-env.sh` to write the real file with random values. The Compose
# file reads it from this directory.

POSTGRES_USER=restichub
# Generate a value with: head -c 32 /dev/urandom | base64
POSTGRES_PASSWORD=
POSTGRES_DB=restichub

# The passwords of the two installation logins. `db-bootstrap` sets them.
RESTICHUB_OWNER_PASSWORD=
RESTICHUB_RUNTIME_PASSWORD=

# The key encryption key. It must hold 32 bytes in standard base64, or the
# control plane refuses to start. Keep a copy: a new key makes the stored secrets
# unreadable.
RESTICHUB_KEK=

# The domain of the control plane. Caddy gets the certificate for this domain.
RESTICHUB_DOMAIN=restichub.example.com
RESTICHUB_ACME_EMAIL=admin@example.com

# The verified image to deploy, pinned by digest. Verify the image and read its digest
# with the guide "Verify a release" before you start it.
RESTICHUB_IMAGE=ghcr.io/fgbm/restichub-cp@sha256:replace-with-the-verified-digest

# The address that agents dial for the agent listener (port 8443 by default).
RESTICHUB_AGENT_ENDPOINT=https://agents.example.com:8443

RESTICHUB_TENANCY_MODE=single
RESTICHUB_TRUSTED_PROXIES=172.28.0.0/24
