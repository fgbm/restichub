# Example environment for the staging stack. This file holds no real secret.
#
# Run `bootstrap.sh` on the staging server to write `.env` with random values.
# The Compose file reads `.env` from the deployment directory.

# The PostgreSQL superuser of the staging cluster.
POSTGRES_USER=restichub
# Generate a value with: head -c 32 /dev/urandom | base64
POSTGRES_PASSWORD=
POSTGRES_DB=restichub

# The passwords of the two installation logins. `db-bootstrap` sets them with
# `ALTER ROLE`. Generate each value with: head -c 32 /dev/urandom | base64
RESTICHUB_OWNER_PASSWORD=
RESTICHUB_RUNTIME_PASSWORD=

# The key encryption key (KEK). It must hold 32 bytes in standard base64, or the
# control plane refuses to start. Generate one with:
#
#   head -c 32 /dev/urandom | base64
RESTICHUB_KEK=

# The domain of the staging server. Caddy gets the certificate for this domain.
RESTICHUB_DOMAIN=rh-stage.app.galen-is.ru
# The address that Caddy gives to the certificate authority.
RESTICHUB_ACME_EMAIL=admin@galen-is.ru

# The image tag to deploy: `edge` or `sha-<short>`.
RESTICHUB_IMAGE_TAG=edge

# The tenancy mode: `single` or `multi`. The staging server uses `multi` to
# exercise the tenant path. See design/adr/0024-single-tenant-mode.md.
RESTICHUB_TENANCY_MODE=multi

# The networks whose `X-Forwarded-For` header the control plane trusts. The list
# holds the Caddy network alone, so no other peer can set the client address.
RESTICHUB_TRUSTED_PROXIES=172.28.0.0/24
